# Godot 4+ specific ignores
.godot/
.import/

# Imported translations (automatically generated from CSV files)
export.cfg
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build output
build/
*.apk
*.aab

# Local dev tooling (Godot editor, SDK trees, etc.)
tools/

# System / editor
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Keystores and signing secrets — never commit
*.keystore
*.jks
release.keystore
debug.keystore

# HyperFrames video renders (keep source, drop binary output)
videos/*/renders/
videos/*/render.log
videos/*/.hyperframes/
videos/*/.thumbnails/
videos/*/node_modules/
*.mp4
